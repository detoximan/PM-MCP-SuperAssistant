# Корневая папка, к которой сервер даёт доступ.
FS_ROOT=~/pm_developer

# Bearer-токен. Сгенерируй: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FS_AUTH_TOKEN=

# 1 = только чтение, 0 = чтение и запись
FS_READ_ONLY=0

# Сеть
FS_PORT=8765
FS_HOST=0.0.0.0

# Notion API (опционально)
NOTION_TOKEN=
NOTION_WRITE_ENABLED=0

# Tavily API (структурированный веб-поиск)
# Получить бесплатный ключ: https://tavily.com (1000 запросов/месяц)
TAVILY_API_KEY=
