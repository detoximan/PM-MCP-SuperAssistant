# Скопируй в корень pm-filesystem-mcp как .env и заполни.
# НИКОГДА не коммить настоящий .env с токеном.
FS_ROOT=/home/paul/pm_developer
# Сгенерируй токен: python3 -c "import secrets; print(secrets.token_hex(32))"
FS_AUTH_TOKEN=
FS_PORT=8766
FS_HOST=127.0.0.1

